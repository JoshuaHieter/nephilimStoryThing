# Quartz build artifacts.
# NOTE: content/ is NOT ignored — Quartz's file scan respects .gitignore, so
# ignoring content/ makes the build find 0 pages. content/ is a copy of
# "Vault/quartz chapters" refreshed on every build (local & Cloudflare).
node_modules/
public/
.quartz/
.quartz-cache/

# OS
.DS_Store
Thumbs.db

# Obsidian per-device UI state (synced to phone via Syncthing, not git)
Vault/.obsidian/workspace.json
Vault/.obsidian/workspace-mobile.json

# Syncthing (see PHONE.md)
Vault/.stfolder/
Vault/.stversions/
*.sync-conflict-*
